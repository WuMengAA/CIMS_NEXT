# --- Database ---
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/cims

# --- Redis ---
REDIS_URL=redis://:password@localhost:6379/0

# --- Multi-tenancy ---
CIMS_BASE_DOMAIN=miniclassisland.com

# --- Trusted reverse proxy / tunnel entry ---
# 只有当请求对端落在这些网段内时，才采信 CF-Connecting-IP / X-Forwarded-For /
# X-Real-IP 判定客户端真实 IP；否则一律回退对端 IP。
# 直连部署留空；挂了 Nginx 或 Cloudflare Tunnel 时必须配置，否则所有公网客户端
# 会被限流中间件视为同一个 IP，互相牵连封禁。
# 示例：Cloudflare Tunnel（cloudflared 在本机）填 127.0.0.1
#       Nginx 同机填 127.0.0.1；Nginx 在别的机器填该机内网地址
CIMS_TRUSTED_PROXIES=

# --- Ports ---
CIMS_CLIENT_PORT=27041
CIMS_MANAGEMENT_PORT=27042
CIMS_ADMIN_PORT=27043
CIMS_GRPC_PORT=27044

# --- Super-admin ---
CIMS_ADMIN_SECRET=change-me

# --- GPG Key ---
CIMS_KEY_FILE=cims_server.key
